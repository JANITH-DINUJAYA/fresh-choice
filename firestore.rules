rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User helper function
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && 
        (getUserRole() == 'super_admin' || getUserRole() == 'admin' || getUserRole() == 'staff');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || getUserRole() == 'super_admin');
    }

    // Meals Collection
    match /meals/{mealId} {
      allow read: if true; // Public menu browsing
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if true; // Anyone can place order
      allow update, delete: if isAdmin();
    }

    // Contact Messages
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
